# 可选：兼容 Chat Completions 格式的服务。
# 复制为 .env 后填写。留空时使用明确标识的本地演示，不会发送外部请求。
# 密钥仅由本机 Node 服务读取；不要使用 VITE_ 前缀，也不要提交 .env。
AI_API_KEY=
# 示例：https://your-provider.example/v1
# HTTPS；本机模型服务可使用 http://127.0.0.1:端口/v1
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# chat = Chat Completions；responses = Responses（例如站点 GPT 接入文档）
AI_PROTOCOL=chat
